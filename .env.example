# ── Base de datos (requerida por casi todos los proyectos) ──────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=lva
# Scores usa su propia base
SCORES_DB_NAME=go

# ── Autenticación ───────────────────────────────────────────────────────────
# Firma el JWT del panel de admin (cookie b2b_admin_token).
# Obligatoria en producción: sin ella el arranque falla a propósito.
ADMIN_JWT_SECRET=
# Pepper de los PIN. Igual que arriba: obligatorias en producción.
MUNDIAL_PIN_PEPPER=
SCORES_PIN_PEPPER=
AUTH_SECRET=
# Protege los endpoints /api/scores/cron/*
CRON_SECRET=
SCORES_CRON_SECRET=
# Código del panel de Xtreme
XTREME_ADMIN_CODE=

# ── Correo (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
SMTP_FROM=
MAPS_PITCH_REPLY_TO=

# ── PayPal (mundial premium y checkout de Xtreme) ───────────────────────────
PAYPAL_MODE=sandbox
PAYPAL_CURRENCY=USD
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_MODE=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_PAYPAL_SANDBOX_CLIENT_ID=

# ── Google Maps (maps-scrapper) ─────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=
MAPS_KEY=
NEXT_PUBLIC_MAPS_JS_KEY=
NEXT_PUBLIC_MAPS_MAP_ID=
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# ── Carrera multijugador (npm run ws) ───────────────────────────────────────
GAME_WS_PORT=3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# ── Otros ───────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
MUNDIAL_ROSTERS_SOURCE_URL=
SCORES_MODEL_PREDICTIONS_ENABLED=false
